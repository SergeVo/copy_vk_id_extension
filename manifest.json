{
  "manifest_version": 3,
  "name": "VK ID",
  "version": "1.3.1",
  "description": "Показывает числовой ID пользователя ВК по ссылке на профиль. Работает без токена и логина.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "offscreen", "scripting", "activeTab"],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VK ID",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
